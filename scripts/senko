#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(dirname -- "$(dirname -- "$SCRIPT_PATH")")"
PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"

if [[ ! -x "$PYTHON_BIN" ]]; then
    echo "Senko virtual environment is missing. Run 'uv sync --all-packages' in $PROJECT_DIR." >&2
    exit 1
fi

export PYTHONPATH="$PROJECT_DIR/client/src:$PROJECT_DIR/protocol/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON_BIN" -m senko_client.senko_cli "$@"
